# ─────────────────────────────────────────────────────────────────────────────
#  NetGuard — configuration. Copier en .env :  cp .env.example .env
#  ⚠ Ne JAMAIS committer le fichier .env (il est dans .gitignore).
# ─────────────────────────────────────────────────────────────────────────────

# ── Serveur ──────────────────────────────────────────────────────────────────
PORT=5050
NODE_ENV=production

# ── Base de données (Docker Compose) ─────────────────────────────────────────
# POSTGRES_PASSWORD est OBLIGATOIRE. Générer une valeur forte :
#   openssl rand -base64 24
POSTGRES_DB=netguard
POSTGRES_USER=netguard
POSTGRES_PASSWORD=change_me_strong_password

# En dehors de Docker (Postgres déjà installé sur la machine), définir plutôt :
# DATABASE_URL=postgresql://netguard:motdepasse@localhost:5432/netguard

# ── Sessions (OBLIGATOIRE en prod) ───────────────────────────────────────────
# Secret de signature des cookies de session. Générer :
#   openssl rand -hex 32
SESSION_SECRET=change_me_64_hex_chars
# true derrière HTTPS (le compose le force déjà à true)
COOKIE_SECURE=true

# ── CORS ─────────────────────────────────────────────────────────────────────
# Domaine(s) autorisé(s), séparés par des virgules. Vide = tout autorisé (dev).
CORS_ORIGINS=https://tondomaine.com

# ── Limites ──────────────────────────────────────────────────────────────────
MAX_REQUESTS_PER_MINUTE=5
SCAN_TIMEOUT_MS=8000
SCAN_DELAY_MS=150

# ── Alertes email (optionnel) ────────────────────────────────────────────────
ENABLE_EMAIL_ALERTS=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
ALERT_EMAIL_FROM=alerts@netguard.local
