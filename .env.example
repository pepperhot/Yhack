# ─────────────────────────────────────────────────────────────────────────────
#  NetGuard — configuration. Copier en .env :  cp .env.example .env
#  ⚠ Ne JAMAIS committer le fichier .env (il est dans .gitignore).
# ─────────────────────────────────────────────────────────────────────────────

# ── Serveur ──────────────────────────────────────────────────────────────────
PORT=5050
NODE_ENV=production

# ── Base de données ──────────────────────────────────────────────────────────
# SQLite = un simple fichier local, aucune config réseau, aucun mot de passe.
# Par défaut : ./data/netguard.db (créé automatiquement). À changer seulement
# si tu veux stocker le fichier ailleurs :
# DB_PATH=/var/lib/netguard/netguard.db

# ── Sessions (OBLIGATOIRE en prod) ───────────────────────────────────────────
# Secret de signature des cookies de session. Générer :
#   openssl rand -hex 32
SESSION_SECRET=change_me_64_hex_chars
# true derrière HTTPS uniquement (sinon le login casse en HTTP)
COOKIE_SECURE=false

# ── CORS ─────────────────────────────────────────────────────────────────────
# Domaine(s) autorisé(s) pour les appels cross-origin, séparés par des virgules.
# Vide = AUCUNE origine tierce autorisée (sécurisé : le front est same-origin).
# Ne renseigner que si une autre origine doit appeler l'API.
CORS_ORIGINS=

# ── Limites ──────────────────────────────────────────────────────────────────
MAX_REQUESTS_PER_MINUTE=5
SCAN_TIMEOUT_MS=8000
SCAN_DELAY_MS=150

# ── Interface d'administration (/admin) ──────────────────────────────────────
# Email du compte administrateur. DOIT correspondre à un compte déjà inscrit
# (crée-le via l'inscription normale, puis mets son email ici).
# Laisser vide = interface admin totalement désactivée (404).
ADMIN_EMAIL=
# Restriction par IP : liste blanche séparée par des virgules (ton IP fixe/VPN).
# Hors de ces IP, /admin et /api/admin renvoient 404 (invisible).
# Vide = restriction IP inactive (à ne PAS laisser vide en prod).
# Astuce : récupère ton IP publique avec  curl ifconfig.me
ADMIN_ALLOWED_IPS=
# Durée (minutes) de l'accès admin avant de redemander le mot de passe.
ADMIN_ELEVATION_TTL_MIN=15

# ── Alertes email (optionnel) ────────────────────────────────────────────────
ENABLE_EMAIL_ALERTS=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
ALERT_EMAIL_FROM=alerts@netguard.local
